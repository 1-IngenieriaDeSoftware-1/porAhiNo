# Normalizar finales de línea en el repositorio
# Los archivos de texto usan LF en el repo (estándar Unix/Linux)
# Git convierte a CRLF en Windows automáticamente al hacer checkout

* text=auto eol=lf

# Archivos específicos
*.py    text eol=lf
*.ts    text eol=lf
*.tsx   text eol=lf
*.js    text eol=lf
*.json  text eol=lf
*.md    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.css   text eol=lf
*.ini   text eol=lf
*.txt   text eol=lf
*.mako  text eol=lf

# Binarios — no tocar
*.png   binary
*.jpg   binary
*.ico   binary
