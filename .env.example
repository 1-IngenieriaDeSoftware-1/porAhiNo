# =============================================
# porAhiNo — variables de entorno (raíz del repo)
# Copiar a `.env` y rellenar. NUNCA commitear `.env`.
# El docente crea este archivo antes de `docker compose up -d --build`.
# =============================================

# --- PostgreSQL en la nube (Clever Cloud u otro) ---
# Solo nombres de variables en el repo; valores reales van en el correo de entrega.
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=
DB_NAME=

# --- JWT (opcional; hay default de desarrollo en compose) ---
# SECRET_KEY=

# --- Frontend build (opcional) ---
# NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
