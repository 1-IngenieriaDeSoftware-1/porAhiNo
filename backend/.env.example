# =============================================
# porAhiNo Backend — Variables de entorno
# Copiar a .env y rellenar valores reales.
# NUNCA commitar el archivo .env al repositorio.
# =============================================

# --- Base de datos PostgreSQL ---
# A) Backend en el host (venv) + Postgres contenedor `db`:
DATABASE_URL=postgresql+asyncpg://porAhiNo_user:porAhiNo_pass@localhost:5432/porAhiNo_db
DATABASE_URL_SYNC=postgresql://porAhiNo_user:porAhiNo_pass@localhost:5432/porAhiNo_db

# B) Backend también en Docker Compose (servicio `backend` → host del Postgres = `db`):
# DATABASE_URL=postgresql+asyncpg://porAhiNo_user:porAhiNo_pass@db:5432/porAhiNo_db
# DATABASE_URL_SYNC=postgresql://porAhiNo_user:porAhiNo_pass@db:5432/porAhiNo_db

# C) Clever Cloud (US-DB-10 / demo equipo): POSTGRESQL_ADDON_* (NUNCA commits de secretos).
# Puerto remoto ≠ 5432. SSL: ?ssl=require (async) / ?sslmode=require (sync).
# DATABASE_URL=postgresql+asyncpg://USER:PASS@HOST:PORT/DB?ssl=require
# DATABASE_URL_SYNC=postgresql://USER:PASS@HOST:PORT/DB?sslmode=require

# --- JWT / Seguridad ---
SECRET_KEY=cambia_esto_por_una_clave_secreta_larga_y_aleatoria
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- CORS ---
# Lista JSON (pydantic-settings). También acepta CSV si el parser custom lo lee.
ALLOWED_ORIGINS=["http://localhost:3000","https://por-ahi-no.vercel.app"]

# --- Entorno ---
ENVIRONMENT=development
DEBUG=true
