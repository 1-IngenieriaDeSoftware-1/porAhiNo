# =============================================
# porAhiNo Frontend — Variables de entorno
# Copiar a .env.local y rellenar valores reales.
# Las variables NEXT_PUBLIC_* son visibles en el cliente.
# =============================================

# URL base de la API REST del backend (FastAPI)
# Desarrollo local:
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Producción (Render/Railway):
# NEXT_PUBLIC_API_URL=https://api.porAhiNo.com/api/v1

# Nombre de la app (usado en metadatos PWA)
NEXT_PUBLIC_APP_NAME=porAhiNo
NEXT_PUBLIC_APP_DESCRIPTION=Consulta restricciones de Pico y Placa en Colombia
